# Public DNS
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# Generate each secret independently with: openssl rand -base64 48
POSTGRES_DB=black_whale
POSTGRES_USER=bw_user
POSTGRES_PASSWORD=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Rotating ADMIN_PASSWORD invalidates every admin session cookie issued before
# the change: the cookie carries a binding to the password it was issued against.

BACKUP_RETENTION_DAYS=14

# Off-site copy of the state dump — the tables git cannot rebuild. Leave these
# empty and the backup behaves exactly as before, on the server's volume alone.
# Encryption happens on this host, with the public half of a key pair generated
# on your own machine: a server that can decrypt its own off-site backups has
# not really put them anywhere else. See infrastructure/hetzner/README.md §5.
BACKUP_REMOTE_TARGET=
BACKUP_REMOTE_PORT=23
BACKUP_AGE_RECIPIENT=
BACKUP_SSH_KEY_FILE=
BACKUP_KNOWN_HOSTS_FILE=
