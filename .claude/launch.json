{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@black-whale/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-3100",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@black-whale/web",
        "exec",
        "vite",
        "dev",
        "--port",
        "3100",
        "--strictPort"
      ],
      "port": 3100
    },
    {
      "name": "signature-combos",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/web/scripts/serve-fighting-demo.mjs",
        "--demo=signature-combos",
        "--port=3210"
      ],
      "port": 3210
    },
    {
      "name": "feitan-intro",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/web/scripts/serve-fighting-demo.mjs",
        "--demo=feitan-intro",
        "--port=3211"
      ],
      "port": 3211
    }
  ]
}