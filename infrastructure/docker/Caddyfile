{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}
}

# Replace, don't append: `{remote_host}` is the real TCP peer, so a
# client-supplied X-Forwarded-For never reaches the apps. The login rate limiter
# and the API throttler both key on this value.
(client_ip) {
	header_up X-Forwarded-For {remote_host}
	header_up X-Real-IP {remote_host}
}

{$DOMAIN} {
	import security_headers

	# SvelteKit only marks its own hashed bundles (`/_app/immutable`) as
	# cacheable; everything under `static/` is served with no freshness at all,
	# so the fonts are re-fetched on every visit. These filenames are stable and
	# their contents never change in place — a new face gets a new file name.
	header /fonts/* Cache-Control "public, max-age=31536000, immutable"
	# The icons and the share card do get replaced in place occasionally, so they
	# get a long-but-revalidatable window instead of `immutable`.
	header /favicon.svg Cache-Control "public, max-age=604800"
	header /apple-touch-icon.png Cache-Control "public, max-age=604800"
	header /og-default.png Cache-Control "public, max-age=604800"

	encode zstd gzip
	reverse_proxy web:3000 {
		import client_ip
	}
}

admin.{$DOMAIN} {
	import security_headers
	# The back-office holds unpublished editorial data: keep it out of indexes
	# and out of any shared cache.
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		Cache-Control "no-store, private"
	}
	encode zstd gzip
	reverse_proxy admin:3002 {
		import client_ip
	}
}
