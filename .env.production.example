# Public DNS
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# Generate each secret independently with: openssl rand -base64 48
POSTGRES_DB=black_whale
POSTGRES_USER=bw_user
POSTGRES_PASSWORD=replace-with-a-long-random-secret
REDIS_PASSWORD=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Rotating ADMIN_PASSWORD invalidates every admin session cookie issued before
# the change: the cookie carries a binding to the password it was issued against.

BACKUP_RETENTION_DAYS=14
