coverage/

# Environnement Python local (scripts/ et outils d'import de données). Il est
# reconstruit par `python -m venv .venv`, il contient des binaires compilés
# pour la machine qui l'a créé, et il n'a rien à faire dans l'historique.
.venv/

# Written by infrastructure/hetzner/deploy.sh, one line per release. It
# describes the host it was deployed on, not the code, and deploy.sh refuses a
# checkout that git reports as dirty — so leaving it tracked makes the second
# deploy on any host impossible.
.deploy-history
