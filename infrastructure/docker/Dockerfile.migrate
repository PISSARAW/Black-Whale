FROM node:20-alpine
RUN apk add --no-cache openssl libc6-compat
RUN corepack enable
WORKDIR /app
COPY . .
# The Prisma CLI is a dev dependency of the database package, so the install has
# to happen before NODE_ENV is pinned to production.
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @black-whale/database generate
# The backfills read the domain rules rather than restating them — the voyage
# clock formats its hours there — and a workspace package resolves to its built
# `dist/`, which nothing else in this image produces. Without this the timeline
# backfill dies on a missing module *after* `migrate:deploy` has moved the
# schema, which leaves the deploy half-applied and the site behind a gate that
# never opens.
RUN pnpm --filter @black-whale/domain build
# canon-lint runs from the same image, against the same `data/` the backfills
# are about to read.
RUN pnpm --filter @black-whale/contracts build
ENV NODE_ENV=production
USER node
# `migrate:deploy` only moves the schema. Everything the archive actually shows —
# locations, characters, presences — lives in data/*.json and reaches the
# database solely through the backfills, so a deploy that stopped at the schema
# shipped new code onto an old catalogue: the map would query rooms production
# did not have. The backfills are idempotent and ordered, timeline first because
# the catalogue anchors its trajectories on the events it declares.
# canon-lint comes first, and before the schema moves: the backfills read
# `data/` and write it into the database, so a catalogue that contradicts
# itself becomes a database that contradicts itself. Failing here costs
# nothing — deploy.sh runs this container on its own, and the previous release
# is still serving.
CMD ["sh", "-c", "pnpm --filter @black-whale/contracts canon-lint && pnpm --filter @black-whale/database migrate:deploy && pnpm --filter @black-whale/database db:backfill-timeline && pnpm --filter @black-whale/database db:backfill-map"]
