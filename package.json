{
  "name": "black-whale",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @black-whale/database generate",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "pnpm --filter \"./apps/*\" exec svelte-kit sync && eslint .",
    "lint:fix": "eslint . --fix",
    "test": "turbo test",
    "test:ratchet": "vitest run",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rimraf node_modules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "turbo test:coverage",
    "audit": "pnpm audit --prod --audit-level high",
    "canon-lint": "pnpm --filter @black-whale/contracts canon-lint:dev",
    "doc:gen": "tsx scripts/doc-gen/generate.ts",
    "doc-lint": "tsx scripts/doc-lint.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10",
    "eslint-plugin-svelte": "^3.22.0",
    "fast-glob": "^3.3.0",
    "globals": "^17.8.0",
    "playwright": "^1.62.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^4.1.1",
    "rimraf": "^5.0.0",
    "svelte-eslint-parser": "^1.8.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.4.0"
}
