FROM node:20-alpine AS builder
RUN apk add --no-cache openssl libc6-compat
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @black-whale/database generate
RUN pnpm turbo build --filter=@black-whale/web

FROM node:20-alpine AS runner
RUN apk add --no-cache openssl libc6-compat
WORKDIR /app

# `COPY --from=builder /app /app` used to bring the whole checkout into the
# image that faces the internet: every source file, every test, the SvelteKit
# and Vite toolchains, the .svelte-kit intermediates, pnpm itself. None of it is
# opened by `node apps/web/build`. What follows is that list, and only it.
#
# node_modules is still the full install rather than a production-only one: the
# Prisma client is *generated into* node_modules and its CLI is a dev
# dependency, so a `--prod` reinstall here would drop the generated client with
# no way to rebuild it. Splitting that out is a follow-up — the image build
# added to CI alongside this change is what makes such a follow-up safe.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/web/build ./apps/web/build
COPY --from=builder /app/apps/web/package.json ./apps/web/package.json
# pnpm does not hoist: a dependency declared by apps/web resolves through
# apps/web/node_modules, a farm of symlinks into the root .pnpm store, and
# nowhere else. Leaving it out is why the first deploy of the slimmed image
# answered 500 on every page that touches the database — `@prisma/client` is
# declared here, not at the root, so Node walked up from apps/web/build, found
# no apps/web/node_modules, reached the root one, and did not find it there
# either. The store it points into is the node_modules copied above.
COPY --from=builder /app/apps/web/node_modules ./apps/web/node_modules
# Read from disk at request time by `lib/server/data-files.ts`, which walks up
# from the working directory looking for it — hence /app, not /app/apps/web.
COPY --from=builder /app/data ./data

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000
USER node
CMD ["node", "apps/web/build"]
