FROM node:20-alpine
RUN apk add --no-cache openssl libc6-compat
RUN corepack enable
WORKDIR /app
COPY . .
# The Prisma CLI is a dev dependency of the database package, so the install has
# to happen before NODE_ENV is pinned to production.
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @black-whale/database generate
ENV NODE_ENV=production
USER node
# `migrate:deploy` only moves the schema. Everything the archive actually shows —
# locations, characters, presences — lives in data/*.json and reaches the
# database solely through the backfills, so a deploy that stopped at the schema
# shipped new code onto an old catalogue: the map would query rooms production
# did not have. The backfills are idempotent and ordered, timeline first because
# the catalogue anchors its trajectories on the events it declares.
CMD ["sh", "-c", "pnpm --filter @black-whale/database migrate:deploy && pnpm --filter @black-whale/database db:backfill-timeline && pnpm --filter @black-whale/database db:backfill-map"]
