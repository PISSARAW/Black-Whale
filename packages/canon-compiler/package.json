{
  "name": "@black-whale/canon-compiler",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "compile:map": "node dist/cli/compile-map.js",
    "compile:map:dev": "tsx src/cli/compile-map.ts",
    "compile:timeline": "node dist/cli/compile-timeline.js",
    "compile:timeline:dev": "tsx src/cli/compile-timeline.ts",
    "compile:identities": "node dist/cli/compile-identities.js",
    "compile:identities:dev": "tsx src/cli/compile-identities.ts",
    "verify:map": "node dist/cli/verify-map.js",
    "verify:map:dev": "tsx src/cli/verify-map.ts",
    "compile:chapters": "node dist/cli/compile-chapters.js",
    "compile:chapters:dev": "tsx src/cli/compile-chapters.ts",
    "sync:passengers:dev": "tsx src/cli/sync-passengers.ts",
    "enrich:passengers:dev": "tsx src/cli/enrich-passengers.ts",
    "fill:appearances:dev": "tsx src/cli/fill-appearances.ts"
  },
  "dependencies": {
    "@black-whale/contracts": "workspace:*",
    "@black-whale/domain": "workspace:*",
    "@prisma/client": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^2.0.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
